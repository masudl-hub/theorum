{
  "name": "@theorum/core",
  "version": "0.1.13",
  "description": "A flat TypeScript agent kernel for typed profiles, deterministic turn execution, dynamic tools, provider adapters, guardrails, and host-injected traces.",
  "license": "MIT",
  "keywords": [
    "agent",
    "ai",
    "kernel",
    "llm",
    "typescript",
    "deno",
    "node",
    "openrouter",
    "gemini"
  ],
  "exports": {
    ".": "./mod.ts",
    "./kernel": "./src/kernel/mod.ts",
    "./providers": "./src/providers/mod.ts",
    "./openrouter": "./src/providers/openrouter-mod.ts",
    "./guardrails": "./src/guardrails/mod.ts",
    "./observability": "./src/observability/mod.ts",
    "./host": "./src/host/mod.ts",
    "./cli": "./src/cli/index.ts",
    "./presets": "./src/presets/mod.ts",
    "./presets/google": "./src/presets/google.ts",
    "./streaming": "./src/streaming/mod.ts"
  },
  "publish": {
    "exclude": [
      ".fallow/",
      ".fallowrc.jsonc",
      ".github/",
      ".gitignore",
      "ast-grep-rules/",
      "biome.json",
      "deno.lock",
      "knip.json",
      "stryker.config.json",
      "stryker.log",
      ".stryker-tmp/",
      ".stryker-cache/",
      "coverage/",
      "cov_profile/",
      "traces/",
      "reports/",
      "node_modules/",
      "npm/",
      "package-lock.json",
      "scripts/",
      "sgconfig.yml",
      "tests/"
    ]
  },
  "imports": {
    "@openrouter/ai-sdk-provider": "npm:@openrouter/ai-sdk-provider@^3.0.0",
    "ai": "npm:ai@^7.0.0",
    "gpt-tokenizer": "npm:gpt-tokenizer@^4.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@deno/dnt": "jsr:@deno/dnt@0.43.2"
  },
  "tasks": {
    "theorum": "deno run --allow-read --allow-write --allow-net src/cli/index.ts",
    "test": "deno test --allow-read --allow-write --allow-net --allow-env --allow-sys --ignore=npm/ tests/",
    "check": "deno check mod.ts",
    "verify:publish": "deno run --allow-read scripts/verify-publish-bundle.ts",
    "lint": "npm run lint",
    "verify:live": "deno run --allow-net scripts/verify-live.ts"
  }
}
