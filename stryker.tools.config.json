{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker/master/packages/core/schema/stryker-core.schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "deno test --no-check --allow-read --allow-write --allow-net --allow-env --allow-sys tests/kernel/tools.adversarial.test.ts tests/providers/google/interactions/stream.test.ts"
  },
  "mutate": [
    "src/kernel/tools/execute.ts",
    "src/kernel/tools/resolve.ts",
    "src/providers/google/interactions/stream.ts"
  ],
  "ignorePatterns": [
    "coverage",
    "npm",
    "docs",
    ".stryker-cache",
    ".stryker-tmp",
    "node_modules",
    "traces",
    "cov_profile",
    ".fallow"
  ],
  "reporters": ["clear-text", "progress"],
  "coverageAnalysis": "off",
  "incremental": true,
  "incrementalFile": ".stryker-cache/tools-incremental.json",
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": null
  },
  "timeoutMS": 120000,
  "concurrency": 4,
  "ignoreStatic": false
}
